{
  "expo": {
    "name": "MegaPlay",
    "slug": "MegaPlay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/user_icon1.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/user_splash1.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF007F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.MegaPlay"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/user_icon1.png",
        "backgroundColor": "#FF007F" 
      },
      "splash": {
        "backgroundColor": "#FF007F" 
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.MegaPlay"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-font"
    ]
  }
}